{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": { "@shopfast/platform/*": ["libs/platform/src/*"] }
  },
  "include": ["apps/**/*.ts", "libs/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "apps/web"]
}
