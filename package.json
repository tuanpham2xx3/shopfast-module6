{
  "name": "shopfast",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.18.1 <23"
  },
  "scripts": {
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:gemini": "ts-node scripts/gemini-smoke.ts",
    "smoke:gemini-agent": "ts-node scripts/gemini-agent-smoke.ts",
    "dev:doctor": "ts-node scripts/dev-doctor.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "ts-node database/migrate.ts",
    "db:seed": "ts-node database/seeds/development.ts",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:coverage": "jest --config jest.business.config.js --runInBand",
    "test:e2e": "playwright test",
    "build": "npm run build:api && npm run build:worker && npm run build:web",
    "build:api": "nest build api",
    "build:worker": "nest build worker",
    "build:web": "npm run build --workspace @shopfast/web",
    "dev:api": "nest start api --watch",
    "dev:worker": "nest start worker --watch",
    "dev:web": "npm run dev --workspace @shopfast/web",
    "format": "prettier --write \"{apps,libs,database,tests,scripts}/**/*.{ts,tsx,js,json}\" \"*.{json,js}\"",
    "format:check": "prettier --check \"{apps,libs,database,tests,scripts}/**/*.{ts,tsx,js,json}\" \"*.{json,js}\"",
    "lint": "eslint \"{apps,libs,database,tests,scripts}/**/*.{ts,tsx}\"",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=contract",
    "test:contract": "jest --runInBand --testPathPattern=contract",
    "typecheck": "tsc --noEmit",
    "start:api": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/worker/src/main.js",
    "harness:preflight": "node harness/run.mjs preflight",
    "harness:ci": "node harness/run.mjs ci",
    "harness:staging": "node harness/run.mjs staging",
    "harness:providers": "node harness/run.mjs providers",
    "harness:resilience": "node harness/run.mjs resilience",
    "harness:performance": "node harness/run.mjs performance",
    "harness:backup-restore": "node harness/run.mjs backup-restore",
    "harness:deploy-rollback": "node harness/run.mjs deploy-rollback",
    "harness:report": "node harness/run.mjs report",
    "test:unit:coverage": "jest --config jest.unit-business.config.js --runInBand",
    "harness:all": "node harness/all.mjs"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/websockets": "^10.4.22",
    "argon2": "0.44.0",
    "bullmq": "^5.81.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "express": "^4.22.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "9.0.2",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "typeorm": "^0.3.31",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.22",
    "@playwright/test": "^1.56.1",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "^4.17.25",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.24",
    "@types/pdfkit": "^0.17.3",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "eslint": "9.38.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  }
}
