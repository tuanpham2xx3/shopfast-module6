{
  "name": "shopfast",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.18.1 <23"
  },
  "scripts": {
    "build": "npm run build:api && npm run build:worker && npm run build:web",
    "build:api": "nest build api",
    "build:worker": "nest build worker",
    "build:web": "npm run build --workspace @shopfast/web",
    "dev:api": "nest start api --watch",
    "dev:worker": "nest start worker --watch",
    "dev:web": "npm run dev --workspace @shopfast/web",
    "format": "prettier --write \"{apps,libs,database,tests}/**/*.{ts,tsx,js,json}\" \"*.{json,js}\"",
    "format:check": "prettier --check \"{apps,libs,database,tests}/**/*.{ts,tsx,js,json}\" \"*.{json,js}\"",
    "lint": "eslint \"{apps,libs,tests}/**/*.{ts,tsx}\"",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=contract",
    "test:contract": "jest --runInBand --testPathPattern=contract",
    "typecheck": "tsc --noEmit",
    "start:api": "node dist/apps/api/main.js",
    "start:worker": "node dist/apps/worker/main.js"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/swagger": "7.4.2",
    "bullmq": "^5.81.5",
    "express": "^4.22.2",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "^0.3.31",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.22",
    "@types/express": "^4.17.25",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.24",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "eslint": "9.38.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  }
}
