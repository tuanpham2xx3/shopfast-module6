{
  "$schema": "https://json.schemastore.org/nest-cli",
  "monorepo": true,
  "root": "BE/api",
  "sourceRoot": "BE/api/src",
  "compilerOptions": {
    "webpack": false,
    "deleteOutDir": false,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "dtoFileNameSuffix": [".dto.ts", ".module.ts"],
          "controllerFileNameSuffix": [".controller.ts", ".module.ts"],
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ]
  },
  "projects": {
    "api": {
      "type": "application",
      "root": "BE/api",
      "entryFile": "main",
      "sourceRoot": "BE/api/src",
      "compilerOptions": { "tsConfigPath": "BE/api/tsconfig.app.json" }
    },
    "worker": {
      "type": "application",
      "root": "BE/worker",
      "entryFile": "main",
      "sourceRoot": "BE/worker/src",
      "compilerOptions": { "tsConfigPath": "BE/worker/tsconfig.app.json" }
    }
  }
}
