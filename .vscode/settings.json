{
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/test-results": true,
    "**/playwright-report": true,
    "**/*.tsbuildinfo": true,
    "**/*.log": true,
    "**/*.pem": true,
    "**/*.ppk": true,
    ".env": true,
    ".env.local": true,
    ".env.production": true,
    ".env.development": true,
    ".env.test": true,
    ".secrets": true,
    ".codex": true,
    ".superpowers": true,
    ".playwright-mcp": true,
    "harness/reports": true,
    "tools/.runtime": true,
    "tools/references": true,
    "tools/reports": true
  },
  "search.exclude": {
    ".env": true,
    ".env.local": true,
    ".env.production": true,
    ".env.development": true,
    ".env.test": true,
    ".secrets/**": true,
    ".codex/**": true,
    ".superpowers/**": true,
    "harness/reports/**": true,
    "tools/.runtime/**": true,
    "tools/references/**": true,
    "tools/reports/**": true
  },
  "explorer.compactFolders": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, tsconfig*.json, nest-cli.json, eslint.config.js, jest*.js, playwright.config.ts, .prettierrc.json, .dockerignore, .gitattributes, .gitignore, .env.example",
    "README.md": "AGENTS.md, Module *.txt"
  }
}
