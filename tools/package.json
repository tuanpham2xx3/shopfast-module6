{
  "name": "shopfast-development-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Development tooling only; application dependencies are installed during implementation.",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "mcp:setup": "node scripts/setup-mcp.mjs",
    "references:sync": "node scripts/sync-references.mjs",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "browser:smoke": "node scripts/browser-smoke.mjs",
    "http:smoke": "node scripts/http-smoke.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "format:check": "prettier --check ../README.md ../docs ../AGENTS.md package.json references.json \"scripts/*.mjs\"",
    "load": "autocannon"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "overrides": {
    "hyperid": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.64.1",
    "@upstash/context7-mcp": "4.4.2",
    "autocannon": "8.0.0",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  }
}
