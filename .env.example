NODE_ENV=development
HOST=127.0.0.1
PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://shopfast:change-me@127.0.0.1:5432/shopfast
DATABASE_SCHEMA=public
REDIS_URL=redis://127.0.0.1:6379
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Required only for development seed; missing accounts are created without resetting existing passwords.
DEV_SEED_PASSWORD=replace-with-a-local-demo-password
# Backend only. Choose a function-calling model enabled for your Google AI Studio project.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional separate invoice signing key (>=32 characters); ACCESS_TOKEN_SECRET is used in development.
INVOICE_SIGNING_SECRET=
# Real email adapter requires an HTTPS provider accepting the Idempotency-Key header.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=ShopFast <no-reply@mail.shopfast.tuanpq.com>
EMAIL_TEST_TO=
# Explicit sandbox partner contract for the public demo, never a real external partner claim.
PARTNER_SYNC_MODE=
